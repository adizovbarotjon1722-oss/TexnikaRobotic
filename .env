# Nusxa oling: .env  (yoki hostingning "Variables" bo'limiga kiriting). Bu faylni hech kimga bermang.

# Admin panel paroli (kamida 10 belgi). Faqat birinchi ishga tushishda o'rnatiladi, keyin admin paneldan o'zgartiriladi.
ADMIN_PASSWORD=1234512345.Barotjon,1

# Saytning haqiqiy manzili (SEO, sitemap, Telegram havolalari uchun)
PUBLIC_URL=https://example.uz
NODE_ENV=production
# Hosting proksi orqasida bo'lsa (Railway, Render, Nginx) 1 qiling
TRUST_PROXY=1
# Ma'lumotlar bazasi va rasmlar papkasi (hostingda doimiy disk/volume ga ulang)
DATA_DIR=/data
PORT=8080

# AI tashxis (AI Gateway). Masalan Vercel AI Gateway: https://ai-gateway.vercel.sh
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=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
# Gateway orqali odatda "anthropic/claude-opus-5.5", to'g'ridan-to'g'ri Anthropic API bilan "claude-opus-5-5"
AI_MODEL=claude-opus-5-5
# Gateway ishlatmasangiz, o'rniga shu kalit yetarli:
ANTHROPIC_API_KEY=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

# Telegram xabarnomalar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=1047268578
# Telegramdan /holat buyrug'i bilan ariza holatini o'zgartirish uchun (16+ belgi, faqat harf, raqam, _ va -)
TELEGRAM_WEBHOOK_SECRET=1234512345.Barotjon,1
