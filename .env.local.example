# O'z kompyuteringizda ishga tushirish uchun. Bu faylni .env nomi bilan saqlang va hech kimga bermang.

# Admin panel paroli (kamida 10 belgi)
ADMIN_PASSWORD=

# Hozircha shu manzil. Cloudflare Tunnel ishga tushgach, u bergan https manzilni yozing.
PUBLIC_URL=http://localhost:3080
NODE_ENV=production
TRUST_PROXY=1
# Ma'lumotlar bazasi va rasmlar shu papkada saqlanadi (sayt papkasi ichida)
DATA_DIR=./data
PORT=3080

# AI tashxis: kalit bo'lsa yozing, bo'lmasa bo'sh qoldiring
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Telegram xabarnomalar (bot tokeni va sizning chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mijoz boti va Mini App uchun (16+ belgi). Faqat https manzil bo'lganda ishlaydi.
TELEGRAM_WEBHOOK_SECRET=
