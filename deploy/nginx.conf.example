# VPS uchun: Node server 127.0.0.1:8080 da ishlaydi, Nginx HTTPS ni beradi.
# /etc/nginx/sites-available/texnika ga nusxa oling, DOMEN ni almashtiring, certbot bilan SSL oling.
server {
  listen 80;
  listen [::]:80;
  server_name DOMEN www.DOMEN;
  return 301 https://DOMEN$request_uri;
}
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name DOMEN;
  ssl_certificate     /etc/letsencrypt/live/DOMEN/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/DOMEN/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  server_tokens off;
  client_max_body_size 16m;
  gzip on;
  gzip_types text/css application/javascript image/svg+xml application/json text/xml;

  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }
}
# Server muhitida TRUST_PROXY=1 bo'lishi shart (aks holda barcha tashrifchilar bitta IP bo'lib ko'rinadi).
