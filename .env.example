# Nusxa oling: .env  (yoki hostingning "Variables" bo'limiga kiriting). Bu faylni hech kimga bermang.

# Admin panel paroli (kamida 10 belgi). Faqat birinchi ishga tushishda o'rnatiladi, keyin admin paneldan o'zgartiriladi.
ADMIN_PASSWORD=

# Saytning haqiqiy manzili (SEO, sitemap, Telegram havolalari uchun)
PUBLIC_URL=https://example.uz
NODE_ENV=production
# Hosting proksi orqasida bo'lsa (Railway, Render, Nginx) 1 qiling
TRUST_PROXY=1
# Ma'lumotlar bazasi va rasmlar papkasi (hostingda doimiy disk/volume ga ulang)
DATA_DIR=/data
PORT=8080

# AI tashxis (AI Gateway). Masalan Vercel AI Gateway: https://ai-gateway.vercel.sh
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
# Gateway orqali odatda "anthropic/claude-opus-5.5", to'g'ridan-to'g'ri Anthropic API bilan "claude-opus-5-5"
AI_MODEL=claude-opus-5-5
# Gateway ishlatmasangiz, o'rniga shu kalit yetarli:
# ANTHROPIC_API_KEY=

# Telegram xabarnomalar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mijoz boti, Mini App va /holat buyrug'i uchun majburiy (16+ belgi, faqat harf, raqam, _ va -)
TELEGRAM_WEBHOOK_SECRET=
# Mini App'da boshqaruv bo'limini ko'radigan qo'shimcha Telegram ID lar (vergul bilan). TELEGRAM_CHAT_ID egasi doim admin.
TELEGRAM_ADMIN_IDS=

# Google Search Console va Yandex Webmaster tasdiqlash kodlari (admin panel > Sozlamalar'dan ham kiritiladi)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# --- Ro'yxatdan o'tishda tasdiqlash kodi ---
# SMS: Eskiz.uz kabinetidagi login va parol. SMS matni Eskiz'da shablon sifatida tasdiqlangan bo'lishi kerak:
#   "Texnika Servis: tasdiqlash kodi 123456. Kodni hech kimga bermang."
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Email: Brevo API kaliti va Brevo'da tasdiqlangan jo'natuvchi email
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Texnika Servis
