{
  "name": "texnika-servis",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Texnika Servis: sanoat robotlari va uskunalari servisi sayti (server, admin panel, AI tashxis, akademiya)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/server.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/server.mjs",
    "build:static": "node build.mjs",
    "test": "node --disable-warning=ExperimentalWarning server/selftest.mjs",
    "admin-parol": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/admin-password.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "qrcode-generator": "1.4.4"
  }
}
